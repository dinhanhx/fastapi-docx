# Server Configuration
# PORT: Server port (default: 9700)
PORT=9700

# WORKERS: Number of uvicorn worker processes (default: 1)
WORKERS=1

# RELOAD: Enable auto-reload on file changes (default: false)
RELOAD=false

# MAX_UPLOAD_BYTES: Maximum file upload size in bytes (default: 5242880 = 5 MB)
MAX_UPLOAD_BYTES=5242880

# CONVERSION_TIMEOUT: Seconds to wait for a single Word conversion before killing Word (default: 120)
CONVERSION_TIMEOUT=120

